{
  "$schema": "https://aka.ms/vscode-remote/devcontainer-schema",
  "name": "Python3 and Redis",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "workspace",
  // "forwardPorts": [
  //   5501
  // ],
  // "appPort": 5501,
  // Mount the local workspace folder into the container
  "workspaceMount": "source=${localWorkspaceFolder},target=/work,type=bind",
  "workspaceFolder": "/work",
  // Install Python and pipenv using pyenv
  // "postCreateCommand": "pip install pipenv && pyenv install 3.11.4 && pyenv global 3.11.4",
  "postCreateCommand": "pip --disable-pip-version-check --no-cache-dir install -r requirements.txt -r requirements-dev.txt && curl https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash",
  "runArgs": [
    "--env-file",
    ".devcontainer/devcontainer.env"
  ],
  "containerEnv": {
    "FLASK_ENV": "development"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "github.copilot",
        "github.copilot-chat"
      ],
      "settings": {
        "github.copilot.chat.enabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit"
          }
        }
      }
    }
  }
}