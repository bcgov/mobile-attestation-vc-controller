# Copy to src/.env and fill in. Paths here are relative to the directory you run the
# controller from, which is the repo root (`python src/controller.py`).
#
# NOTE: FLASK_ENV does NOT belong in this file. The app only reads .env when
# FLASK_ENV=development, so it has to come from the shell:
#   export FLASK_ENV=development
# The devcontainer sets it for you.

# Traction tenant to issue through. Tenant ID, API key and the public DID are all on
# Settings -> Tenant Profile in the tenant UI.
TRACTION_BASE_URL="https://traction-tenant-proxy-dev.apps.silver.devops.gov.bc.ca"
TRACTION_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
TRACTION_TENANT_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TRACTION_LEGACY_DID="xxxxxxxxxxxxxxxxxxxxxx"

# The cred def whose issuer DID matches TRACTION_LEGACY_DID is the one used. Create it
# in your own tenant with `python scripts/schema.py && python scripts/cred_def.py`,
# then put the printed ID here. Defaults to the deployed BC Wallet cred defs, which
# your tenant does not own.
ATTESTATION_CRED_DEF_IDS="xxxxxxxxxxxxxxxxxxxxxx:3:CL:000:bcwallet"

# redis://127.0.0.1:6379/0 for docker-compose.local.yml (running on the host);
# redis://redis-1:6379/0 inside the devcontainer.
REDIS_URI="redis://127.0.0.1:6379/0"

MESSAGE_TEMPLATES_PATH="fixtures/"
APPLE_ATTESTATION_ROOT_CA_URL="https://www.apple.com/certificateauthority/Apple_App_Attestation_Root_CA.pem"
GOOGLE_AUTH_JSON_PATH="google_oauth_key.json"

# Apps this instance accepts. Both default to BC Wallet alone, so add the bundles you
# are testing with. IDs come from variants/*/variant.env in the wallet repo.
ALLOWED_APPLE_APP_IDS="L796QSLV3E.ca.bc.gov.BCWallet,L796QSLV3E.ca.bc.gov.iddev.servicescard"
ALLOWED_GOOGLE_PACKAGE_NAMES="ca.bc.gov.BCWallet,ca.bc.gov.id.servicescard.dev"

# Accepts Play Integrity verdicts other than PLAY_RECOGNIZED. Required for any build
# not installed from Google Play.
ALLOW_TEST_BUILDS="true"

# v1 = issue-credential/1.0, v2 = issue-credential/2.0 + anoncreds. A client can
# override per request by sending credential_protocol.
DEFAULT_CREDENTIAL_PROTOCOL="v1"
